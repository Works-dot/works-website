{
  "name": "@workspace/strapi",
  "private": true,
  "version": "0.1.0",
  "description": "Works. CMS — Strapi v5",
  "scripts": {
    "dev": "NODE_ENV=development STRAPI_PLUGIN_I18N_INIT_LOCALE_CODE=hu NODE_OPTIONS='--require dotenv/config' node scripts/prepare-development-i18n.mjs && NODE_ENV=development STRAPI_PLUGIN_I18N_INIT_LOCALE_CODE=hu NODE_OPTIONS='--require dotenv/config' strapi develop --no-watch-admin",
    "start": "NODE_ENV=production NODE_OPTIONS='--require dotenv/config' strapi start",
    "build": "NODE_OPTIONS='--require dotenv/config' strapi build",
    "strapi": "strapi",
    "translations:export": "NODE_ENV=development NODE_OPTIONS='--require dotenv/config' node scripts/export-translations.mjs",
    "translations:translate": "NODE_ENV=development NODE_OPTIONS='--require dotenv/config' node scripts/translate-export.mjs",
    "translations:import": "NODE_ENV=development NODE_OPTIONS='--require dotenv/config' node scripts/import-translations.mjs",
    "translations:validate": "NODE_ENV=development NODE_OPTIONS='--require dotenv/config' node scripts/validate-translations.mjs"
  },
  "dependencies": {
    "@strapi/admin": "^5.12.6",
    "@strapi/design-system": "2.2.0",
    "@strapi/icons": "2.2.0",
    "@strapi/plugin-users-permissions": "^5.12.6",
    "@strapi/strapi": "^5.12.6",
    "axios": "^1.13.5",
    "better-sqlite3": "^11.9.1",
    "dotenv": "^17.3.1",
    "pg": "^8.16.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-router-dom": "^6.0.0",
    "styled-components": "^6.0.0"
  },
  "pnpm": {
    "overrides": {
      "react": "^18.0.0",
      "react-dom": "^18.0.0"
    }
  },
  "engines": {
    "node": ">=18.0.0 <=22.x.x"
  }
}
